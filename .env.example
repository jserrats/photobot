# Compose interpolation variables. Copy to .env next to docker-compose.yml, or enter
# them in your container manager's "Environment variables" page.
# Telegram bot token from @BotFather. Never commit the real value.
BOT_TOKEN=
# Numeric id of the only chat allowed to use the bot. Send the bot a message and
# read the id from the "unauthorized chat" warning in the container logs.
DEVELOPER_CHAT_ID=
# Optional: host directory where pictures and videos are stored (default ./files).
# Relative paths are resolved from the directory containing docker-compose.yml.
# HOST_FILES_DIR=/srv/photobot/files
# Optional: uid/gid the container runs as; must be able to write HOST_FILES_DIR.
# PUID=1000
# PGID=1000
# Optional: DEBUG, INFO, WARNING, ERROR (default INFO).
# LOG_LEVEL=INFO
# Optional: your time zone, used for the "Today"/"Yesterday" buttons when the bot asks
# when a photo was taken (default UTC). Any IANA name, e.g. Europe/Madrid.
# TZ=Europe/Madrid
# Optional: how long a batch keeps accepting photos, in seconds. Photos sent within
# this long of each other share one capture-date question (default 30).
# DATE_PROMPT_WINDOW_SECONDS=30
