# Telegram bot token from @BotFather. Never commit the real value.
BOT_TOKEN=
# Numeric id of the only chat allowed to use the bot. Send the bot a message and
# read the id from the "unauthorized chat" warning in the container logs.
DEVELOPER_CHAT_ID=
# Optional: host directory where pictures and videos are stored (default ./files).
# Relative paths are resolved from the directory containing docker-compose.yml.
# HOST_FILES_DIR=/srv/photobot/files
# Optional: uid/gid the container runs as; must be able to write HOST_FILES_DIR.
# PUID=1000
# PGID=1000
# Optional: where files are stored inside the container (default /files).
# DOWNLOAD_DIR=/files
# Optional: DEBUG, INFO, WARNING, ERROR (default INFO).
# LOG_LEVEL=INFO
